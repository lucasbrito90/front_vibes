+    public void loopWithFadeIn(double time, float volume, double fadeInDurationMs) throws Exception {
+        AudioDispatcher audio = audioList.get(playIndex);
+        if (audio != null) {
+            cancelFade();
+            audio.setVolume(0);
+            audio.loop();
+            playIndex++;
+            playIndex = playIndex % audioList.size();
