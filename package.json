{
  "name": "front_vibes",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "vue-tsc && vite build",
    "build:staging": "vue-tsc && vite build --mode staging",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:cypress": "cypress run",
    "test:unit": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "cap:sync:android": "cap sync android",
    "build:android:smoke": "VITE_E2E_MOCK_AUTH=true npm run build && npm run cap:sync:android",
    "test:native-offline-qa:android": "wdio run wdio.android.offline-qa.conf.ts",
    "test:native-pause-resume-qa:android": "wdio run wdio.android.pause-resume-qa.conf.ts",
    "test:native-media-notification-qa:android": "wdio run wdio.android.media-notification-qa.conf.ts",
    "test:native-scheduler-e2e:android": "wdio run wdio.android.scheduler-e2e.conf.ts",
    "test:native-automation-badges:android": "wdio run wdio.android.automation-badges.conf.ts",
    "capture:playback-logcat": "bash scripts/capture-playback-logcat.sh",
    "android:apk:debug": "cd android && ./gradlew assembleDebug",
    "appium:setup": "appium driver install uiautomator2",
    "test:smoke:android": "wdio run ./wdio.android.conf.ts",
    "postinstall": "patch-package && node scripts/patch-android-foreground-service.cjs",
    "capacitor:sync:after": "node scripts/patch-android-foreground-service.cjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.0",
    "@capacitor-firebase/messaging": "^8.3.0",
    "@capacitor/android": "^8.3.3",
    "@capacitor/app": "8.1.0",
    "@capacitor/core": "8.3.1",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.3",
    "@capacitor/local-notifications": "^8.2.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@capawesome-team/capacitor-android-foreground-service": "^8.1.0",
    "@capgo/native-audio": "^8.4.2",
    "@codetrix-studio/capacitor-google-auth": "^3.4.0-rc.4",
    "@ionic/vue": "^8.0.0",
    "@ionic/vue-router": "^8.0.0",
    "firebase": "^12.12.1",
    "ionicons": "^7.0.0",
    "pinia": "^3.0.4",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.3.1",
    "@playwright/test": "^1.52.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.0",
    "@vitejs/plugin-legacy": "^5.0.0",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.3.0",
    "@wdio/appium-service": "^9.12.0",
    "@wdio/cli": "^9.12.0",
    "@wdio/local-runner": "^9.12.0",
    "@wdio/mocha-framework": "^9.12.0",
    "@wdio/spec-reporter": "^9.12.0",
    "@wdio/types": "^9.12.0",
    "appium": "^2.19.0",
    "appium-uiautomator2-driver": "^4.2.0",
    "cypress": "^13.5.0",
    "eslint": "^8.35.0",
    "eslint-plugin-vue": "^9.9.0",
    "jsdom": "^22.1.0",
    "patch-package": "^8.0.1",
    "terser": "^5.4.0",
    "typescript": "~5.9.0",
    "vite": "^5.0.0",
    "vitest": "^0.34.6",
    "vue-tsc": "^2.1.10",
    "webdriverio": "^9.12.0"
  },
  "description": "An Ionic project"
}
