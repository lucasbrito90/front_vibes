# Staging mode — remote staging API
# Loaded automatically when running: npm run build:staging / npm run dev:staging
VITE_API_BASE_URL=https://staging-api.ixora-app.app

# OpenTelemetry — mobile OTLP ingestion endpoint (Caddy → Collector :4319)
# Set this variable to enable telemetry. When unset, the OTel SDK is a no-op.
# Endpoint: https://otel-mobile-staging.ixora-app.app
VITE_OTEL_ENDPOINT=https://otel-mobile-staging.ixora-app.app

# OpenTelemetry — bearer token for the mobile ingest key (OTEL_INGEST_API_KEY_MOBILE).
# DO NOT commit the real value here — inject at build time via CI env var or local shell:
#   VITE_OTEL_INGEST_API_KEY=<token> npm run build:staging
# Reference: ixora-infra/docs/specs/observability-foundation/mvp/app-platform-otel-integration.md
# VITE_OTEL_INGEST_API_KEY=

# OpenTelemetry — deployment environment label (ADR-029 §4, default: "staging")
# VITE_OTEL_DEPLOYMENT_ENV=staging

# OpenTelemetry — app version injected into service.version resource attribute.
# In CI this should be set to the git tag or build number.
# VITE_APP_VERSION=0.0.1
