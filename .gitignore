# Specifies intentionally untracked files to ignore when using Git
# http://git-scm.com/docs/gitignore

.env
.env.*
*~
*.env
*.sw[mnpcod]
.tmp
*.tmp
*.tmp.*
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
UserInterfaceState.xcuserstate
$RECYCLE.BIN/

*.log
log.txt
npm-debug.log*

/.idea
/.ionic
/.sass-cache
/.sourcemaps
/.versions
/.vscode/*
!/.vscode/extensions.json
/coverage
/dist
/node_modules
/playwright-report
/test-results
/blob-report
/playwright/.cache
/wdio-logs

# Native Android QA harness — local device run artifacts only
/qa-android-native/output/
/platforms
/plugins
/www

# Backup files created by ionic capacitor run --live-reload
*.orig

# GH02 spike — Google Home Android SDK (188MB, beta, not redistributable — see
# docs/specs/smart-home/google-home/access-gate.md finding B). Each dev downloads
# it from https://developers.home.google.com/apis/android/sdk and extracts here.
android/google-home-sdk-repo/
